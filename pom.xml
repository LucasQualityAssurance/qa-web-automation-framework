<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.lqa</groupId>
    <artifactId>qa-web-automation-framework</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>qa-web-automation-framework</name>

    <!--
        Projeto multi-módulo:
        - core: page objects, DriverFactory, utilitários e massa de dados compartilhados
        - selenium-java: testes em JUnit 5
        - selenium-java-cucumber: cenários BDD com Cucumber
    -->
    <modules>
        <module>core</module>
        <module>selenium-java</module>
        <module>selenium-java-cucumber</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <selenium.version>4.52.0</selenium.version>
        <allure.version>2.35.1</allure.version>
        <!-- Permite usar -Dtest=... na raiz sem falhar nos módulos que não têm aquele teste -->
        <surefire.failIfNoSpecifiedTests>false</surefire.failIfNoSpecifiedTests>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>br.com.lqa</groupId>
                <artifactId>core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Mantém todos os artefatos do JUnit na mesma versão (o Allure traz um JUnit launcher mais antigo) -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.13.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Mantém todos os artefatos do Cucumber na mesma versão -->
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>7.20.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Sobrescreve para corrigir uma dependência transitiva vulnerável trazida pelo selenium-java -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api</artifactId>
                <version>1.67.0</version>
            </dependency>
            <dependency>
                <groupId>org.seleniumhq.selenium</groupId>
                <artifactId>selenium-java</artifactId>
                <version>${selenium.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-jupiter</artifactId>
                <version>${allure.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-cucumber7-jvm</artifactId>
                <version>${allure.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <!-- Propriedades passadas com -D (ex.: -Dheadless=true) chegam aos testes sem precisar declará-las aqui -->
                        <systemPropertyVariables>
                            <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <!-- Gera e abre o relatório: mvn allure:serve -pl <módulo> (baixa a ferramenta do Allure automaticamente) -->
                <plugin>
                    <groupId>io.qameta.allure</groupId>
                    <artifactId>allure-maven</artifactId>
                    <version>2.15.2</version>
                    <configuration>
                        <reportVersion>2.30.0</reportVersion>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
